          "id": "001417e1-5324-4b0b-8b15-6d433e6cc4fe",
          "name": "List available models",
          "request": {
            "name": "List available models",
            "description": {
              "content": "Returns the Pioneer model catalog including base encoder models (GLiNER), base decoder LLMs, and any fine-tuned models you have deployed. Compatible with both Anthropic and OpenAI model-list consumers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "models"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of models to return. Omit for the full catalog."
                },
                {
                  "disabled": false,
                  "key": "before_id",
                  "value": "<string>",
                  "description": "Cursor for paginating backward (Anthropic-style)."
                },
                {
                  "disabled": false,
                  "key": "after_id",
                  "value": "<string>",
                  "description": "Cursor for paginating forward (Anthropic-style)."
