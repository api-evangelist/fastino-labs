              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\",\n      \"tool_calls\": \"<array>\",\n      \"tool_call_id\": \"<string>\"\n    }\n  ],\n  \"temperature\": \"<number>\",\n  \"max_tokens\": \"<integer>\",\n  \"stream\": false,\n  \"stop\": \"<string>\",\n  \"response_format\": \"<object>\",\n  \"tools\": \"<array>\",\n  \"tool_choice\": \"<string>\",\n  \"top_p\": \"<number>\",\n  \"store\": true,\n  \"metadata\": \"<object>\",\n  \"reasoning\": \"<object>\",\n  \"schema\": \"<object>\",\n  \"seed\": \"<integer>\",\n  \"n\": \"<integer>\",\n  \"presence_penalty\": \"<number>\",\n  \"frequency_penalty\": \"<number>\",\n  \"user\": \"<string>\"\n}",
